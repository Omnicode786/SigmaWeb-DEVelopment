// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`



generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  // the above is an id of string type with default 
  // as uuid = standard of ids in apis it generates a random id for each user
  name String
  email String @unique
  password String

  createdAt DateTime @default(now())

  // Relations
  watchListItems WatchListItem[]
  movies Movie[] @relation("MovieCreator")
}



model Movie {
id String @id @default(uuid())
title String
overview String
releaseYear Int
genres String[] @default([])
runtime Int? 
postedUrl String?
// the question mark simply we means it could be this but we arent exactly sure


createdBy String
createdAt DateTime @default(now())


// relations

  creator User @relation("MovieCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  watchListItems WatchListItem[]

}

// user -> movie -> watch list


model WatchListItem {
  id String @id @default(uuid())
  title String
  userId String
  movieId String
  status WatchListStatus @default(PLANNED)

  // the above is a customtype in a way its an enum

  rating Int?
  notes String?
  createdAt DateTime @default(now())

  // I noticed you have updatedAt DateTime @default(now()). In Prisma, you can make this automatically update whenever the record changes by using @updatedAt:
  updatedAt DateTime @updatedAt
  // updatedAt DateTime @default(now())


// RELATIONS
user User @relation(fields: [userId], references: [id], onDelete: Cascade)
movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)


@@unique([userId, movieId])

}

enum WatchListStatus {
  PLANNED
  WATCHING 
  COMPLETED
  DROPPED
}